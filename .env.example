# Copy this file to .env and fill in your own values.
# .env is listed in .gitignore and must NEVER be committed.

# Required — Django secret key.
# Generate one: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# Required — PostgreSQL connection string.
# Example: postgresql://user:password@localhost:5432/monitrllm
# Falls back to SQLite for local dev if left blank (add a value for PostgreSQL).
DATABASE_URL=

# Optional — set to True only during local development
DEBUG=False

# Optional — comma-separated list of hostnames that Django will serve
# ALLOWED_HOSTS=localhost,127.0.0.1,your-app.herokuapp.com
